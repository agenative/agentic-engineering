# Copy to ~/.config/confluence/confluence.env and replace placeholders.
# This file must contain only op:// secret references for credentials — never plaintext tokens.
# The same Atlassian API token works for both Jira and Confluence.

# Required — point these at the 1Password item holding your Atlassian API token.
# Example item layout: vault "Employee", item "Jira API Token", fields username + password.
CONFLUENCE_API_TOKEN=op://Employee/Jira API Token/password
CONFLUENCE_EMAIL=op://Employee/Jira API Token/username

# Required — your Atlassian Cloud site, without the /wiki suffix (plaintext is fine).
CONFLUENCE_BASE_URL=https://your-company.atlassian.net

# Optional — comma-separated space keys used as the default search/list filter.
# Hygiene only: not a hard allowlist. Your personal token still has whatever access Confluence grants you.
# CONFLUENCE_SPACES=SBE,IT
