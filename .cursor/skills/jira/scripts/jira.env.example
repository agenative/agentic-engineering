# Copy to ~/.config/jira/jira.env and replace placeholders.
# This file must contain only op:// secret references for credentials — never plaintext tokens.
# See: https://developer.1password.com/docs/cli/secret-references/

# Required — store the personal Jira API token in 1Password, then point these at that item.
# Example item layout: vault "Personal", item "Jira API Token", fields username + credential.
JIRA_API_TOKEN=op://Personal/Jira API Token/credential
JIRA_EMAIL=op://Personal/Jira API Token/username

# Required — your Jira Cloud site (plaintext is fine).
JIRA_BASE_URL=https://your-company.atlassian.net

# Optional — comma-separated project keys used as the default search/list filter.
# Hygiene only: not a hard allowlist. Your personal token still has whatever access Jira grants you.
# JIRA_PROJECTS=ENG,SUP
